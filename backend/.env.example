# Salin ke .env (jangan di-commit).
# Supabase: Dashboard -> Connect -> pooler. Ganti user jadi bemai_app.<project-ref> dan sandi
# sesuai role-app.sql. Gunakan alamat pooler (bukan koneksi langsung, yang umumnya hanya IPv6).
DATABASE_URL=postgresql://bemai_app.PROJECT_REF:SANDI@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Asal yang diizinkan memanggil API (domain frontend), pisahkan dengan koma.
ASAL_DIIZINKAN=https://bemai.contoh.sch.id

COOKIE_SECURE=true        # false hanya untuk http://localhost
SESI_JAM=8
MAKS_GAGAL_LOGIN=5
KUNCI_MENIT=15
